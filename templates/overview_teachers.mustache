{{!
    @template mod_mooduell/overview_teachers
    Template which defines a mooduell view page.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * none
    Context variables required for this template:
    * opengames - array
    * finishedgames - array
    * warnings - array: Array of warnings.
    * quizname - string
    * mooduellid - string
    * questions - array
    * highscores - array
    * categories - array
    * statistics - object

    Example context (json):
    {
       "opengames": [],
       "finishedgames": [],
       "warnings": [],
       "haswunderbyte": true,
       "quizname": "test",
       "mooduellid": "409",
       "questions": [],
       "highscores": [],
       "categories": [],
       "statistics": {
          "courseid": "50",
          "number_of_active_users": "3",
          "number_of_games_started": "2",
          "number_of_games_finished": "0",
          "number_of_answers": "4",
          "percentage_of_correct_answers": false,
          "eq_id": false,
          "eq_name": "Wieviel ist 1 plus 1?",
          "eq_correct_count": 0,
          "hq_id": "5",
          "hq_name": "Wählen Sie alle FALSCHEN ANTWORTEN aus",
          "hq_incorrect_count": "1"
       }
    }

}}

{{#warnings}}
<div class="alert alert-warning alert-dismissible fade show" role="alert">
    <i class="fa fa-exclamation-triangle mr-2" aria-hidden="true"></i>
    {{message}}
    <button type="button" class="close" data-dismiss="alert" data-bs-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
{{/warnings}}

{{#users_without_capability.0}}
<div class="alert alert-warning" role="alert">
    <p><strong>{{#str}} caplistmissingrights, mod_mooduell {{/str}}</strong></p>
    <p>{{#str}} caplistdescription, mod_mooduell {{/str}}</p>
    <button class="btn btn-link btn-sm pl-0" type="button" data-bs-toggle="collapse" data-bs-target="#usersListCollapse" data-toggle="collapse" data-target="#usersListCollapse" aria-expanded="false" aria-controls="usersListCollapse">
        {{#str}} caplistuserlist, mod_mooduell {{/str}}<i class="fas fa-chevron-down"></i>
    </button>
    <div class="collapse" id="usersListCollapse">
        <ul>
            {{#users_without_capability}}
                <li>{{.}}</li>
            {{/users_without_capability}}
        </ul>
    </div>
</div>
{{/users_without_capability.0}}

{{! When local_wunderbyte_table is NOT installed: show only the app preview }}
{{^haswunderbyte}}
{{> mooduell/launch_preview }}
{{/haswunderbyte}}

{{! When local_wunderbyte_table is installed: show earmark-style vertical tabs }}
{{#haswunderbyte}}
<div class="mooduell-earmark-tabs d-flex align-items-start mt-4 gap-3">

    {{! Left vertical nav (earmarks) }}
    <ul class="nav flex-md-column nav-pills mooduell-earmark-nav" id="mooduellEarmarkNav" role="tablist" aria-orientation="vertical">
        <li class="nav-item mb-2" role="presentation">
            <a class="nav-link active" id="mooduell-tab-app" data-bs-toggle="tab" data-toggle="tab"
               href="#mooduell-pane-app" role="tab" aria-controls="mooduell-pane-app" aria-selected="true"
               title="{{#str}} app, mod_mooduell {{/str}}" aria-label="{{#str}} app, mod_mooduell {{/str}}">
                <i class="fa fa-mobile" aria-hidden="true"></i>
            </a>
        </li>
        <li class="nav-item mb-2" role="presentation">
            <a class="nav-link" id="mooduell-tab-statistics" data-bs-toggle="tab" data-toggle="tab"
               href="#mooduell-pane-statistics" role="tab" aria-controls="mooduell-pane-statistics" aria-selected="false"
               title="{{#str}} statistics, mod_mooduell {{/str}}" aria-label="{{#str}} statistics, mod_mooduell {{/str}}">
                <i class="fa fa-bar-chart" aria-hidden="true"></i>
            </a>
        </li>
        <li class="nav-item mb-2" role="presentation">
            <a class="nav-link" id="mooduell-tab-opengames" data-bs-toggle="tab" data-toggle="tab"
               href="#mooduell-pane-opengames" role="tab" aria-controls="mooduell-pane-opengames" aria-selected="false"
               title="{{#str}} opengames, mod_mooduell {{/str}}" aria-label="{{#str}} opengames, mod_mooduell {{/str}}">
                <i class="fa fa-gamepad" aria-hidden="true"></i>
            </a>
        </li>
        <li class="nav-item mb-2" role="presentation">
            <a class="nav-link" id="mooduell-tab-finishedgames" data-bs-toggle="tab" data-toggle="tab"
               href="#mooduell-pane-finishedgames" role="tab" aria-controls="mooduell-pane-finishedgames" aria-selected="false"
               title="{{#str}} finishedgames, mod_mooduell {{/str}}" aria-label="{{#str}} finishedgames, mod_mooduell {{/str}}">
                <i class="fa fa-flag-checkered" aria-hidden="true"></i>
            </a>
        </li>
        <li class="nav-item mb-2" role="presentation">
            <a class="nav-link" id="mooduell-tab-questions" data-bs-toggle="tab" data-toggle="tab"
               href="#mooduell-pane-questions" role="tab" aria-controls="mooduell-pane-questions" aria-selected="false"
               title="{{#str}} questions, mod_mooduell {{/str}}" aria-label="{{#str}} questions, mod_mooduell {{/str}}">
                <i class="fa fa-question-circle" aria-hidden="true"></i>
            </a>
        </li>
        <li class="nav-item mb-2" role="presentation">
            <a class="nav-link" id="mooduell-tab-highscores" data-bs-toggle="tab" data-toggle="tab"
               href="#mooduell-pane-highscores" role="tab" aria-controls="mooduell-pane-highscores" aria-selected="false"
               title="{{#str}} highscores, mod_mooduell {{/str}}" aria-label="{{#str}} highscores, mod_mooduell {{/str}}">
                <i class="fa fa-trophy" aria-hidden="true"></i>
            </a>
        </li>
    </ul>

    {{! Right tab content }}
    <div class="tab-content flex-fill pt-1" id="mooduellEarmarkContent">
        <div class="tab-pane fade show active" id="mooduell-pane-app" role="tabpanel" aria-labelledby="mooduell-tab-app">
            {{> mooduell/launch_preview }}
        </div>
        <div class="tab-pane fade" id="mooduell-pane-statistics" role="tabpanel" aria-labelledby="mooduell-tab-statistics">
            {{> mooduell/table_statistics_teacher }}
        </div>
        <div class="tab-pane fade" id="mooduell-pane-opengames" role="tabpanel" aria-labelledby="mooduell-tab-opengames">
            {{{opengames}}}
        </div>
        <div class="tab-pane fade" id="mooduell-pane-finishedgames" role="tabpanel" aria-labelledby="mooduell-tab-finishedgames">
            {{{finishedgames}}}
        </div>
        <div class="tab-pane fade" id="mooduell-pane-questions" role="tabpanel" aria-labelledby="mooduell-tab-questions">
            <button type="button" class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#mooduell-question-category-modal">
                {{#str}} addquestionstocategory, mod_mooduell {{/str}}
            </button>
            {{{questions}}}
            <div class="modal fade" id="mooduell-question-category-modal" tabindex="-1" aria-labelledby="mooduell-question-category-modal-label" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="mooduell-question-category-modal-label">{{#str}} addquestionstocategory, mod_mooduell {{/str}}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{#str}} closebuttontitle {{/str}}"></button>
                        </div>
                        <div class="modal-body">
                            <form class="d-grid gap-3" id="mooduell-question-create-form"
                                  data-questionnewurl="{{questionnewurl}}"
                                  data-courseid="{{courseid}}"
                                  data-sesskey="{{sesskey}}"
                                  data-cmid="{{mooduellid}}">
                                <div data-region="question-category-step">
                                    <p class="text-muted">{{#str}} selectcategorybelow, mod_mooduell {{/str}}</p>
                                    <label for="mooduell-question-category" class="form-label">{{#str}} category, question {{/str}}</label>
                                    <select id="mooduell-question-category" name="category" class="form-select" required>
                                        {{#questioncategories}}
                                            <option value="{{value}}">{{catname}}</option>
                                        {{/questioncategories}}
                                    </select>
                                    <div class="mt-3">
                                        <button type="button" class="btn btn-primary" data-action="mooduell-question-next-step">{{#str}} continue, core {{/str}}</button>
                                    </div>
                                </div>
                                <div class="d-none" data-region="question-qtype-step">
                                    <p class="text-muted">{{#str}} chooseqtypetoadd, question {{/str}}</p>
                                    <div class="d-grid gap-2">
                                        {{#questiontypes}}
                                        <label class="btn btn-outline-primary text-start">
                                            <input type="radio" name="qtype" value="{{name}}" class="me-2" required>
                                            <strong>{{label}}</strong>
                                        </label>
                                        {{/questiontypes}}
                                    </div>
                                    <div class="modal-footer px-0 pb-0">
                                        <button type="button" class="btn btn-secondary" data-action="mooduell-question-back-step">{{#str}} back {{/str}}</button>
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{#str}} cancel {{/str}}</button>
                                        <button type="submit" class="btn btn-primary">{{#str}} createnewquestion, question {{/str}}</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="mooduell-pane-highscores" role="tabpanel" aria-labelledby="mooduell-tab-highscores">
            {{{highscores}}}
        </div>
    </div>

</div>
{{/haswunderbyte}}

<div class="d-flex justify-content-center" id="spinner">
    <div class="spinner-border hidden" role="status">
        <span class="sr-only">Loading...</span>
    </div>
</div>

{{#js}}
    require(['mod_mooduell/qrrefresh'], function(qr) {
    qr.init();
    });

    document.addEventListener('click', function(event) {
        const nextButton = event.target.closest('[data-action="mooduell-question-next-step"]');
        const backButton = event.target.closest('[data-action="mooduell-question-back-step"]');

        if (!nextButton && !backButton) {
            return;
        }

        const modal = event.target.closest('#mooduell-question-category-modal');
        if (!modal) {
            return;
        }

        const categoryStep = modal.querySelector('[data-region="question-category-step"]');
        const qtypeStep = modal.querySelector('[data-region="question-qtype-step"]');

        if (nextButton) {
            categoryStep.classList.add('d-none');
            qtypeStep.classList.remove('d-none');
        }

        if (backButton) {
            qtypeStep.classList.add('d-none');
            categoryStep.classList.remove('d-none');
        }
    });

    document.getElementById('mooduell-question-create-form').addEventListener('submit', function(event) {
        event.preventDefault();
        const form = event.target;
        const categoryVal = form.querySelector('[name="category"]').value;
        const qtypeInput = form.querySelector('[name="qtype"]:checked');
        if (!qtypeInput) { return; }
        const qtype = qtypeInput.value;
        const cmid = form.dataset.cmid;
        const courseid = form.dataset.courseid;
        const sesskey = form.dataset.sesskey;
        const baseUrl = form.dataset.questionnewurl;
        const returnurl = '/question/edit.php?cmid=' + cmid + '&cat=' + encodeURIComponent(categoryVal) + '&qpage=0';
        window.location.href = baseUrl + '?courseid=' + courseid + '&sesskey=' + sesskey + '&qtype=' + qtype + '&returnurl=' + encodeURIComponent(returnurl) + '&cmid=' + cmid + '&category=' + encodeURIComponent(categoryVal);
    });
{{/js}}